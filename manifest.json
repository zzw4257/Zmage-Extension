{
  "manifest_version": 3,
  "name": "Zmage Collector",
  "description": "Capture images and videos into your Zmage library and trigger follow-up workflows.",
  "version": "0.1.0",
  "default_locale": "en",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zmage Collector"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "cookies",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
